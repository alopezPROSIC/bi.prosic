# =====================================================================
# PROSIC BI — configuración. Copia a `.env` y completa. NUNCA subas .env a git.
# =====================================================================

# ---------- Odoo (usuario dedicado de SOLO LECTURA) ----------
ODOO_URL=https://odoo.prosic.com
ODOO_DB=PS125C53_U41
ODOO_USER=4toangulo@4toangulo.com
ODOO_API_KEY=pega_aqui_la_api_key_del_usuario_de_lectura
# Zona horaria usada para agrupar fechas por mes
ODOO_TZ=America/Mexico_City
ODOO_TIMEOUT_SECONDS=60
ODOO_MAX_RETRIES=3
ODOO_MAX_CONCURRENCY=4
# Tope de registros que un search_read puede traer en total (paginado)
ODOO_MAX_RECORDS=20000

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
KPI_CACHE_TTL_SECONDS=300
AI_CACHE_TTL_SECONDS=21600

# ---------- IA ----------
# Proveedor: groq (gratuito, https://console.groq.com/keys) u openai (de pago)
AI_PROVIDER=groq
# Groq: API compatible con OpenAI. openai/gpt-oss-120b soporta salida estructurada estricta y tools.
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI (solo si AI_PROVIDER=openai). Modelo configurable; debe soportar structured outputs y tools.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Opcional: otra URL compatible con OpenAI (sobrescribe la del proveedor)
AI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=3
# Precio estimado USD por 1M de tokens (solo para el log de costo estimado; 0 con el plan gratuito de Groq)
OPENAI_PRICE_INPUT_PER_1M=0
OPENAI_PRICE_OUTPUT_PER_1M=0
# Anonimiza nombres de clientes/proveedores/vendedores antes de enviarlos al proveedor de IA
AI_ANONYMIZE=true
# Límites por usuario para endpoints de IA
AI_RATE_LIMIT_PER_MINUTE=6
AI_RATE_LIMIT_PER_DAY=200

# ---------- Tareas en segundo plano ----------
# Precalcula cada N minutos los KPIs de "Este mes" para que el dashboard cargue al instante (0 = desactivado)
PREFETCH_MINUTES=5
# Historial diario de flota (SQLite, en el volumen bi_data). Vacío = desactivado
HISTORY_DB_PATH=/data/prosic.db

# ---------- Resumen semanal por correo (opcional) ----------
# Se envía el día/hora indicados si SMTP_HOST y SUMMARY_RECIPIENTS tienen valor.
# Vista previa sin enviar (admin): GET /api/admin/summary/preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Correos separados por coma
SUMMARY_RECIPIENTS=
# 0 = lunes … 6 = domingo; hora local (ODOO_TZ)
SUMMARY_WEEKDAY=0
SUMMARY_HOUR=8
# Umbrales de alerta del resumen
ALERT_UTILIZATION_MIN_PCT=35
ALERT_AR_OVERDUE_MAX_PCT=50
ALERT_QUARANTINE_MAX_PCT=20

# ---------- Acceso con Google (solo cuentas del dominio) ----------
# Client ID de un cliente OAuth "Aplicación web" (Google Cloud Console). Ver README, sección 2.1.
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=prosic.com
# Correos que entran como administradores desde el primer día (separados por coma)
ADMIN_EMAILS=
# Primer ingreso de alguien del dominio: queda "pendiente" hasta que un admin lo apruebe en el panel
# (los dos valores también se cambian desde el panel de administración)
NEW_USER_AUTO_APPROVE=false
NEW_USER_DEFAULT_ROLE=consulta
# Login con usuario/contraseña (AUTH_USERS) como acceso de emergencia.
# Vacío = solo cuando no hay GOOGLE_CLIENT_ID. true/false para forzarlo.
ALLOW_PASSWORD_LOGIN=

# ---------- Autenticación ----------
# Genera un secreto largo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRE_MINUTES=480
# Usuarios: usuario|rol|hash separados por coma. Rol: admin | viewer
# Opcional, limitar a un almacén o sucursal (IDs de Odoo): usuario|viewer|hash|almacen=3  ó  |sucursal=7
# Genera el hash con:  docker compose run --rm backend python -m app.auth hash "MiContraseña"
AUTH_USERS=admin|admin|pbkdf2-sha256.600000.CAMBIA.CAMBIA,direccion|viewer|pbkdf2-sha256.600000.CAMBIA.CAMBIA

# ---------- Web ----------
# Orígenes permitidos (coma). En producción, el dominio público detrás de Cloudflare.
CORS_ORIGINS=https://bi.prosic.com
# Puerto local del frontend (nginx)
FRONTEND_PORT=8080
LOG_LEVEL=INFO
